{
  "info": {
    "name": "Library Book Management API",
    "_postman_id": "library-book-management-api",
    "description": "Postman collection for Library Book Management API deployed on Render.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://library-book-management-api-8m3q.onrender.com"
    },
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "isbn",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "2. Register Book",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('isbn', String(Math.floor(Date.now() / 1000)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Book registered successfully', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('bookId', json.data._id);",
              "pm.collectionVariables.set('isbn', json.data.isbn);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code Postman\",\n  \"isbn\": \"{{isbn}}\",\n  \"authorName\": \"Robert C. Martin\",\n  \"categoryName\": \"Programming\",\n  \"publishedYear\": 2008,\n  \"description\": \"A handbook of agile software craftsmanship.\",\n  \"totalCopies\": 5,\n  \"availableCopies\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books"]
        }
      }
    },
    {
      "name": "3. List Books Paginated",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "4. Search Book by ISBN",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books/isbn/{{isbn}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books", "isbn", "{{isbn}}"]
        }
      }
    },
    {
      "name": "5. Update Book",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code Postman Updated\",\n  \"totalCopies\": 10,\n  \"availableCopies\": 8\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/books/{{bookId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books", "{{bookId}}"]
        }
      }
    }
  ]
}
